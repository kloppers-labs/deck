-- Generated by deck from its language server registry. Do not edit: deck rewrites it.

local deckAnswers = {
    ["workspace/configuration"] = function(request)
        local out = {}
        local items = (request.params or {}).items or {}
        for i = 1, #items do out[i] = json.null end
        return out
    end,
    ["client/registerCapability"] = function() return json.null end,
    ["window/workDoneProgress/create"] = function() return json.null end,
}

local function deckPatchClient(client)
    local mt = getmetatable(client)
    if mt == nil or mt.deckHandleRequest ~= nil then return end
    mt.deckHandleRequest = mt.handleRequest
    mt.handleRequest = function(self, request)
        local answer = deckAnswers[request.method]
        if answer == nil then return mt.deckHandleRequest(self, request) end
        self:responseResult(request.id, answer(request))
    end
end

local deckServers = {
{{- range .}}
    {
        shortName = {{lua .Name}},
        cmd = {{lua .Cmd}},
        args = { {{luaList .Args}} },
        filetypes = { {{luaList .Filetypes}} },
        onInitialized = deckPatchClient,
{{- if .TSServer}}
        initializationOptions = { tsserver = { fallbackPath = {{lua .TSServer}} } },
{{- end}}
{{- if .RequireLocal}}
        deckRequires = {{lua .RequireLocal}},
{{- end}}
    },
{{- end}}
}

local deckOS = import("os")
local deckPath = import("path/filepath")

local function deckFoundAbove(rel)
    local dir = deckOS.Getwd()
    while dir ~= nil and dir ~= "" do
        local _, err = deckOS.Stat(deckPath.Join(dir, rel))
        if err == nil then return true end
        local parent = deckPath.Dir(dir)
        if parent == dir then return false end
        dir = parent
    end
    return false
end

settings.autostart = {}
for _, server in ipairs(deckServers) do
    languageServer["deck-" .. server.shortName] = server
    local usable = server.deckRequires == nil or deckFoundAbove(server.deckRequires)
    for _, ft in ipairs(server.filetypes) do
        if usable then settings.autostart[ft] = { server } end
        settings.defaultLanguageServer[ft] = server
    end
end

settings.showDiagnostics = { error = true, warning = true, information = false, hint = false }
settings.tabAutocomplete = true
